#!/bin/sh
# Refuse pushes outside main or release tags and require the provenance guard.
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/tags/v*) ;;
    *)
      echo "PRE_PUSH_REFUSED: only main and v* tags may be pushed (got $remote_ref)" >&2
      exit 1
      ;;
  esac
done

# The production provenance test is the push gate. Fixture tests create temporary
# Git repositories and belong to the regular solution suite, not this hook.
dotnet test tests/Dw3.Repository.Tests --nologo -v q --filter 'FullyQualifiedName~RealRepositoryTests' >/dev/null || {
  echo "PRE_PUSH_REFUSED: provenance guard failed" >&2
  exit 1
}
